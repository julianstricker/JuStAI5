# Copy to .env and adjust. Everything is optional - `docker compose up -d --build`
# works without a .env file. Secrets (database password, master key) are generated
# automatically on first start into the docker volume "secrets".

# Port of the admin UI / API on the host
JUSTAI_HTTP_PORT=8080
# HTTPS port (device app on phones/tablets/PCs; own local CA, see docs/DEVICES.md)
JUSTAI_HTTPS_PORT=8443
# Extra names/addresses for the HTTPS certificate (JSON list); can also be added in the UI
# JUSTAI_TLS_NAMES=["192.168.0.102"]

# Initial admin account (only used when no user exists yet). Without a password a
# random one is generated and written to /data/initial_admin_password.txt
JUSTAI_ADMIN_USERNAME=admin
# JUSTAI_ADMIN_PASSWORD=change-me-please

# Public URL (used for secure cookies when https)
JUSTAI_PUBLIC_URL=http://localhost:8080

# Optional cloud AI. Keys can also be entered in the admin UI (Plugins -> Gemini).
# GOOGLE_API_KEY=

# Network ranges the device discovery may scan (comma separated JSON list)
# JUSTAI_DISCOVERY_DEFAULT_CIDRS=["192.168.0.0/24"]

JUSTAI_LOG_LEVEL=INFO
